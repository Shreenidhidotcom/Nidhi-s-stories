  {
    "code": "A3",
    "voice": "Ojo",
    "lines": [
      {
        "text": "Tap everything that makes Ojo glow!",
        "ids": [
          "game.glow.prompt"
        ]
      },
      {
        "text": "Help Ayu start her day. Tap in order!",
        "ids": [
          "game.morning.prompt"
        ]
      },
      {
        "text": "Brush away the fuzzy spots!",
        "ids": [
          "game.teeth.prompt"
        ]
      },
      {
