        "ids": [
          "game.plate.prompt"
        ]
      },
      {
        "text": "Help Ojo get ready for bed. Tap in order!",
        "ids": [
          "game.bedtime.prompt"
        ]
      },
      {
        "text": "Feed Ayu one bite at a time. Stop when her tummy feels comfy!",
        "ids": [
          "game.tummy.prompt"
        ]
      },
      {
        "text": "Find the matching pairs!",
        "ids": [
          "game.pairs.prompt"
        ]
      },
