[
  {
    "code": "A1",
    "voice": "Ojo",
    "lines": [
      {
        "text": "Hello, my friend! I am Ojo, the little light inside you.",
        "ids": [
          "ojo.firstMeet.1"
        ]
      },
      {
        "text": "Ayu and I are so happy you are here!",
        "ids": [
          "ojo.firstMeet.2"
        ]
      },
      {
        "text": "Hello! I am Ojo. Ask a grown-up to set up the app for you.",
        "ids": [
          "ojo.welcome.1"
        ]
      },
      {
        "text": "Good morning, my friend! Did you say hello to the sun?",
        "ids": [
          "ojo.morning.1"
        ]
      },
      {
        "text": "Good morning! Have you brushed your teeth?",
        "ids": [
          "ojo.morning.2"
        ]
      },
      {
        "text": "Rise and shine, my friend!",
        "ids": [
          "ojo.morning.3"
        ]
      },
      {
        "text": "Hello, my friend! Shall we find a drop of light?",
        "ids": [
          "ojo.afternoon.1"
        ]
      },
      {
        "text": "Good afternoon! Ready for a story?",
        "ids": [
          "ojo.afternoon.2"
        ]
      },
      {
        "text": "Hello again, my friend!",
        "ids": [
          "ojo.afternoon.3"
        ]
      },
      {
        "text": "Good evening, my friend! Story time soon?",
        "ids": [
          "ojo.evening.1"
        ]
      },
      {
        "text": "The sun is going to sleep. Shall we read?",
        "ids": [
          "ojo.evening.2"
        ]
      },
      {
        "text": "Hello, my friend! A little play before bed?",
        "ids": [
          "ojo.evening.3"
        ]
      },
      {
        "text": "I missed you, my friend! Your garden waited for you.",
        "ids": [
          "ojo.returnAfterBreak.1"
        ]
      },
      {
        "text": "Welcome back! Your flowers are still blooming.",
        "ids": [
          "ojo.returnAfterBreak.2"
        ]
      }
    ]
  },
  {
